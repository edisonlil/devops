FROM python:3.9-slim
MAINTAINER devops@company.com
LABEL maintainer='corp'

# 设置环境变量
ARG main_file=app.py
ARG python_port=8000
ARG requirements_file=requirements.txt
ENV MAIN_FILE=$main_file
ENV PYTHON_PORT=$python_port
ENV REQUIREMENTS_FILE=$requirements_file
ENV TZ=Asia/Shanghai
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# 安装系统依赖
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# 设置工作目录
WORKDIR /app

# 复制requirements文件并安装Python依赖
COPY ./$REQUIREMENTS_FILE /app/requirements.txt
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# 复制应用代码
COPY . /app/

# 创建非root用户
RUN groupadd -r appuser && useradd -r -g appuser appuser && \
    chown -R appuser:appuser /app
USER appuser

# 暴露端口
EXPOSE $PYTHON_PORT

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:$PYTHON_PORT/health || exit 1

# 启动应用
CMD python $MAIN_FILE
