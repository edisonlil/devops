{
  "id": "spring-boot",
  "name": "Spring Boot 标准部署",
  "description": "适用于 Spring Boot 应用的标准 Kubernetes 部署模板，包含服务发现、健康检查等功能",
  "version": "1.0.0",
  "category": "backend",
  "author": "DevOps Team",
  "icon": "CoffeeCup",
  "iconColor": "#10b981",
  "tags": ["spring-boot", "java", "microservice"],
  "platformTypes": ["KUBERNETES"],
  "scope": "global",
  
  "parameters": [
    {
      "name": "module_name",
      "label": "应用名称",
      "type": "string",
      "required": true,
      "placeholder": "demo-app",
      "description": "应用的名称，用于 K8s 资源命名"
    },
    {
      "name": "git_url",
      "label": "Git 仓库地址",
      "type": "string",
      "required": true,
      "placeholder": "https://github.com/example/demo.git",
      "description": "项目的 Git 仓库地址"
    },
    {
      "name": "git_branch",
      "label": "Git 分支",
      "type": "string",
      "default": "master",
      "placeholder": "master",
      "description": "要构建的 Git 分支"
    },
    {
      "name": "image_path",
      "label": "镜像路径",
      "type": "string",
      "required": true,
      "placeholder": "harbor.company.com/project/demo-app",
      "description": "Docker 镜像的完整路径"
    },
    {
      "name": "namespace",
      "label": "K8s 命名空间",
      "type": "string",
      "default": "default",
      "placeholder": "default",
      "description": "Kubernetes 部署的命名空间"
    },
    {
      "name": "app_port",
      "label": "应用端口",
      "type": "number",
      "default": 8080,
      "min": 1000,
      "max": 65535,
      "description": "Spring Boot 应用监听的端口"
    },
    {
      "name": "replicas",
      "label": "副本数",
      "type": "number",
      "default": 2,
      "min": 1,
      "max": 10,
      "description": "Pod 副本数量"
    },
    {
      "name": "cpu_limit",
      "label": "CPU 限制",
      "type": "select",
      "default": "500m",
      "options": [
        {"label": "0.1 核", "value": "100m"},
        {"label": "0.2 核", "value": "200m"},
        {"label": "0.5 核", "value": "500m"},
        {"label": "1 核", "value": "1"},
        {"label": "2 核", "value": "2"}
      ],
      "description": "Pod CPU 资源限制"
    },
    {
      "name": "memory_limit",
      "label": "内存限制",
      "type": "select",
      "default": "1Gi",
      "options": [
        {"label": "512 MB", "value": "512Mi"},
        {"label": "1 GB", "value": "1Gi"},
        {"label": "2 GB", "value": "2Gi"},
        {"label": "4 GB", "value": "4Gi"}
      ],
      "description": "Pod 内存资源限制"
    },
    {
      "name": "java_opts",
      "label": "JVM 参数",
      "type": "string",
      "default": "-Xmx512m -Xms256m",
      "placeholder": "-Xmx512m -Xms256m",
      "description": "JVM 启动参数"
    },
    {
      "name": "health_check_path",
      "label": "健康检查路径",
      "type": "string",
      "default": "/actuator/health",
      "placeholder": "/actuator/health",
      "description": "Spring Boot Actuator 健康检查端点"
    }
  ],
  
  "buildCommands": [
    "mvn clean package -DskipTests",
    "docker build -t ${image_path} .",
    "docker push ${image_path}"
  ],
  
  "files": [
    {
      "name": "dockerfile",
      "description": "Docker 构建文件"
    },
    {
      "name": "deploy.yaml",
      "description": "Kubernetes 部署文件"
    }
  ],
  
  "createdAt": "2024-01-15T00:00:00Z",
  "updatedAt": "2024-01-15T00:00:00Z"
}
