#  enable: true

# Clair配置（已弃用，使用Trivy替代）
#clair:
#  updaters_interval: 12

# 镜像复制配置
#replication:
#  max_replicas: 1024

# 配额配置
quota:
  per_project_enable: {{ quota_per_project_enable }}
  per_project_default_storage: {{ storage_per_project }}

# 机器人账户配置
robot:
  token_duration: {{ robot_token_duration }}

# 用户设置
user_settings:
  self_registration: {{ self_registration }}
  token_expiration: {{ token_expiration }}
  project_creation_restriction: {{ project_creation_restriction }}
  verify_remote_cert: {{ verify_remote_cert }}

# 审计日志配置
audit:
  skip_audit_log_database: false

# 垃圾回收配置
gc:
  workers: 1

# 镜像代理缓存配置
proxy_cache:
  enabled: false
  expire_hours: 24

# 内部TLS配置（可选）
#internal_tls:
#  enabled: true
#  dir: /etc/harbor/tls/internal

# 强制使用TLS
#strong_ssl_ciphers: false

# 上传大小限制
upload_purging:
  enabled: true
  age: 168h
  interval: 24h
  dryrun: false

# 缓存配置
cache:
  enabled: false
  expire_hours: 24

# P2P预热配置
p2p_preheating:
  enabled: false

# 许可证配置（企业版）
#license:
#  path: /path/to/license

# 度量配置
metric:
  enabled: false
  port: 9090
  path: /metrics

# 追踪配置
trace:
  enabled: false
  sample_rate: 1
  jaeger:
    endpoint: http://hostname:14268/api/traces

# 存储配置
storage_service:
  ca_bundle:

# 自动扫描配置
scanner:
  trivy:
    timeout: 5m0s

# 系统配置
system:
  # 系统级别的配置项
  read_only: false

# 网络配置
network:
  # 网络相关配置
  session_timeout: 3600

# 安全配置
security:
  # 安全相关配置
  password_rules:
    min_length: 8
    require_uppercase: true
    require_lowercase: true
    require_number: true
    require_special_char: false

