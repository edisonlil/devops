# Harbor配置文件模板
# 基于Harbor官方配置文件格式

# Harbor主机名配置
hostname: {{ hostname }}

# HTTP配置
http:
  port: {{ http_port }}

{% if https_enabled %}
# HTTPS配置
https:
  port: {{ https_port }}
  certificate: /your/certificate/path
  private_key: /your/private/key/path
{% endif %}

# Harbor管理员初始密码
harbor_admin_password: {{ harbor_admin_password }}

# Harbor数据库配置
database:
  password: {{ database_password }}
  max_idle_conns: 100
  max_open_conns: 900

# 数据存储配置
data_volume: {{ data_path }}

# Trivy扫描器配置
trivy:
  ignore_unfixed: false
  skip_update: false
  offline_scan: false
  security_check: vuln
  insecure: false

# 作业服务配置
jobservice:
  max_job_workers: {{ max_job_workers }}

# 通知配置
notification:
  webhook_job_max_retry: 10

# 图表仓库配置
chart:
  absolute_url: disabled

# 日志配置
log:
  level: {{ log_level }}
  local:
    rotate_count: 50
    rotate_size: 200M
    location: /var/log/harbor

# 代理配置（可选）
#_version: 1.10.0

# 外部URL配置
external_url: {% if https_enabled %}https://{{ hostname }}:{{ https_port }}{% else %}http://{{ hostname }}:{{ http_port }}{% endif %}

