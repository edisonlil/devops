#!/bin/bash

# DevOps 模板管理工具
# 支持从全局模板创建作业配置

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEVOPS_HOME="$(dirname "$SCRIPT_DIR")"
TEMPLATES_DIR="$DEVOPS_HOME/templates"
WORKSPACE_DIR="$DEVOPS_HOME/workspace"

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# 日志函数
log_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

log_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# 显示帮助信息
show_help() {
    cat << EOF
DevOps 模板管理工具

用法:
    devops template <command> [options]

命令:
    list                        列出所有可用模板（全局和workspace）
    show <template-id>          显示模板详情
    copy <template-id> --workspace <workspace>
                               从全局模板复制到workspace
    create <template-id> <job-name> --workspace <workspace>
                               基于模板创建作业配置
    validate <workspace> <job>  验证作业配置

选项:
    --workspace <name>         指定工作空间
    --param <key=value>        设置模板参数
    --output <dir>             指定输出目录
    --dry-run                  仅显示生成的配置，不保存文件

示例:
    # 列出所有模板
    devops template list

    # 查看 Spring Boot 模板详情
    devops template show spring-boot

    # 复制全局模板到workspace
    devops template copy spring-boot --workspace youshen

    # 基于模板创建作业
    devops template create spring-boot demo-app --workspace youshen \\
        --param module_name=demo-app \\
        --param git_url=https://github.com/example/demo.git \\
        --param image_path=harbor.com/project/demo-app

    # 验证作业配置
    devops template validate youshen demo-app
EOF
}

# 列出模板（指定目录）
list_templates_in_dir() {
    local template_dir="$1"
    local label="$2"

    if [ ! -d "$template_dir" ]; then
        return 0
    fi

    local found_any=false
    for platform_dir in "$template_dir"/*; do
        if [ -d "$platform_dir" ]; then
            local platform_name=$(basename "$platform_dir")
            for template_subdir in "$platform_dir"/*; do
                if [ -d "$template_subdir" ]; then
                    found_any=true
                    break 2
                fi
            done
        fi
    done

    if [ "$found_any" = false ]; then
        return 0
    fi

    log_info "$label:"
    echo

    for platform_dir in "$template_dir"/*; do
        if [ -d "$platform_dir" ]; then
            local platform_name=$(basename "$platform_dir")
            echo -e "${BLUE}平台: $platform_name${NC}"

            for template_subdir in "$platform_dir"/*; do
                if [ -d "$template_subdir" ]; then
                    local template_id=$(basename "$template_subdir")
                    local meta_file="$template_subdir/meta.json"

                    if [ -f "$meta_file" ]; then
                        local name=$(jq -r '.name // "未知"' "$meta_file" 2>/dev/null || echo "未知")
                        local description=$(jq -r '.description // "无描述"' "$meta_file" 2>/dev/null || echo "无描述")
                        local category=$(jq -r '.category // "其他"' "$meta_file" 2>/dev/null || echo "其他")

                        echo -e "  ${GREEN}$template_id${NC}"
                        echo "    名称: $name"
                        echo "    分类: $category"
                        echo "    描述: $description"
                    else
                        echo -e "  ${YELLOW}$template_id${NC} (缺少元数据文件)"
                    fi
                    echo
                fi
            done
        fi
    done
}

# 列出所有模板
list_templates() {
    # 获取当前workspace
    local current_workspace=""
    if [ -f "$WORKSPACE_DIR/enable" ]; then
        source "$WORKSPACE_DIR/enable"
        current_workspace="$ENABEL_WORKSPACE_PATH"
    fi

    # 列出全局模板
    list_templates_in_dir "$TEMPLATES_DIR" "全局模板"

    # 列出当前workspace模板
    if [ -n "$current_workspace" ]; then
        local workspace_templates_dir="$WORKSPACE_DIR/$current_workspace/templates"
        list_templates_in_dir "$workspace_templates_dir" "Workspace模板 ($current_workspace)"
    fi
}

# 查找模板目录（优先workspace模板）
find_template_location() {
    local template_id="$1"
    local current_workspace=""

    # 获取当前workspace
    if [ -f "$WORKSPACE_DIR/enable" ]; then
        source "$WORKSPACE_DIR/enable"
        current_workspace="$ENABEL_WORKSPACE_PATH"
    fi

    # 优先查找workspace模板
    if [ -n "$current_workspace" ]; then
        local workspace_templates_dir="$WORKSPACE_DIR/$current_workspace/templates"
        for platform_dir in "$workspace_templates_dir"/*; do
            if [ -d "$platform_dir" ]; then
                local template_dir="$platform_dir/$template_id"
                if [ -d "$template_dir" ]; then
                    echo "$template_dir"
                    return 0
                fi
            fi
        done
    fi

    # fallback到全局模板
    for platform_dir in "$TEMPLATES_DIR"/*; do
        if [ -d "$platform_dir" ]; then
            local template_dir="$platform_dir/$template_id"
            if [ -d "$template_dir" ]; then
                echo "$template_dir"
                return 0
            fi
        fi
    done

    return 1
}

# 显示模板详情
show_template() {
    local template_id="$1"

    if [ -z "$template_id" ]; then
        log_error "请指定模板 ID"
        return 1
    fi

    local template_dir=$(find_template_location "$template_id")
    if [ $? -ne 0 ] || [ -z "$template_dir" ]; then
        log_error "模板不存在: $template_id"
        return 1
    fi

    local meta_file="$template_dir/meta.json"
    
    # 判断模板类型
    local template_type="全局模板"
    if [[ "$template_dir" == "$WORKSPACE_DIR"* ]]; then
        template_type="Workspace模板"
    fi

    log_info "模板详情: $template_id ($template_type)"
    echo
    
    # 基本信息
    echo -e "${GREEN}基本信息:${NC}"
    jq -r '
        "  名称: " + (.name // "未知") + "\n" +
        "  版本: " + (.version // "未知") + "\n" +
        "  分类: " + (.category // "未知") + "\n" +
        "  作者: " + (.author // "未知") + "\n" +
        "  描述: " + (.description // "无描述")
    ' "$meta_file"
    echo
    
    # 支持的平台
    echo -e "${GREEN}支持的平台:${NC}"
    jq -r '.platformTypes[]? // "无"' "$meta_file" | sed 's/^/  - /'
    echo
    
    # 参数列表
    echo -e "${GREEN}模板参数:${NC}"
    jq -r '.parameters[]? | "  - " + .name + " (" + .type + "): " + (.description // "无描述")' "$meta_file"
    echo
    
    # 文件列表
    echo -e "${GREEN}包含的文件:${NC}"
    for file in "$template_dir"/*; do
        if [ -f "$file" ] && [ "$(basename "$file")" != "meta.json" ]; then
            echo "  - $(basename "$file")"
        fi
    done
    echo
}

# 复制全局模板到workspace
copy_template() {
    local template_id=""
    local workspace=""

    # 解析参数
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --workspace)
                workspace="$2"
                shift 2
                ;;
            *)
                if [ -z "$template_id" ]; then
                    template_id="$1"
                else
                    log_error "未知参数: $1"
                    return 1
                fi
                shift
                ;;
        esac
    done

    if [ -z "$template_id" ]; then
        log_error "请指定模板 ID"
        return 1
    fi

    if [ -z "$workspace" ]; then
        log_error "请指定workspace (--workspace <name>)"
        return 1
    fi

    # 检查workspace是否存在
    local workspace_dir="$WORKSPACE_DIR/$workspace"
    if [ ! -d "$workspace_dir" ]; then
        log_error "Workspace不存在: $workspace"
        return 1
    fi

    # 查找全局模板
    local global_template_dir=""
    for platform_dir in "$TEMPLATES_DIR"/*; do
        if [ -d "$platform_dir" ]; then
            local template_dir="$platform_dir/$template_id"
            if [ -d "$template_dir" ]; then
                global_template_dir="$template_dir"
                break
            fi
        fi
    done

    if [ -z "$global_template_dir" ]; then
        log_error "全局模板不存在: $template_id"
        return 1
    fi

    # 确定平台类型
    local platform_name=$(basename "$(dirname "$global_template_dir")")

    # 创建workspace模板目录
    local workspace_template_dir="$workspace_dir/templates/$platform_name/$template_id"

    # 检查是否已存在
    if [ -d "$workspace_template_dir" ]; then
        log_warning "Workspace模板已存在: $template_id"
        read -p "是否覆盖? (y/N): " confirm
        if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
            log_info "取消复制"
            return 0
        fi
        rm -rf "$workspace_template_dir"
    fi

    # 创建目录并复制
    mkdir -p "$workspace_template_dir"
    cp -r "$global_template_dir"/* "$workspace_template_dir/"

    log_success "模板复制成功: $template_id"
    log_info "源: $global_template_dir"
    log_info "目标: $workspace_template_dir"
    echo
    log_info "现在可以编辑workspace模板文件，它将优先于全局模板使用"
}

# 替换模板中的占位符
render_template() {
    local template_file="$1"
    local output_file="$2"
    shift 2
    local params=("$@")
    
    # 复制模板文件
    cp "$template_file" "$output_file"
    
    # 替换参数
    for param in "${params[@]}"; do
        if [[ "$param" == *"="* ]]; then
            key="${param%%=*}"
            value="${param#*=}"
            
            # 使用 sed 替换占位符
            sed -i "s/\${$key}/$value/g" "$output_file"
        fi
    done
}

# 基于模板创建作业配置
create_job() {
    local template_id="$1"
    local job_name="$2"
    local workspace=""
    local params=()
    local output_dir=""
    local dry_run=false
    
    # 解析参数
    shift 2
    while [[ $# -gt 0 ]]; do
        case $1 in
            --workspace)
                workspace="$2"
                shift 2
                ;;
            --param)
                params+=("$2")
                shift 2
                ;;
            --output)
                output_dir="$2"
                shift 2
                ;;
            --dry-run)
                dry_run=true
                shift
                ;;
            *)
                log_error "未知参数: $1"
                return 1
                ;;
        esac
    done
    
    # 验证必需参数
    if [ -z "$template_id" ] || [ -z "$job_name" ]; then
        log_error "请指定模板 ID 和作业名称"
        return 1
    fi
    
    if [ -z "$workspace" ]; then
        log_error "请指定工作空间 (--workspace)"
        return 1
    fi
    
    # 检查模板是否存在
    local template_dir="$TEMPLATES_DIR/$template_id"
    local meta_file="$template_dir/meta.json"
    
    if [ ! -f "$meta_file" ]; then
        log_error "模板不存在: $template_id"
        return 1
    fi
    
    # 检查工作空间是否存在
    local workspace_dir="$WORKSPACE_DIR/$workspace"
    if [ ! -d "$workspace_dir" ]; then
        log_error "工作空间不存在: $workspace"
        return 1
    fi
    
    # 设置输出目录
    if [ -z "$output_dir" ]; then
        output_dir="$workspace_dir/jobs/$job_name"
    fi
    
    log_info "基于模板 '$template_id' 创建作业 '$job_name'"
    log_info "工作空间: $workspace"
    log_info "输出目录: $output_dir"
    
    # 创建输出目录
    if [ "$dry_run" = false ]; then
        mkdir -p "$output_dir"
    fi
    
    # 生成作业配置文件
    local job_config="$output_dir/job.json"
    if [ "$dry_run" = false ]; then
        cat > "$job_config" << EOF
{
  "name": "$job_name",
  "template": "$template_id",
  "workspace": "$workspace",
  "parameters": {
EOF
        
        # 添加参数
        local first=true
        for param in "${params[@]}"; do
            if [[ "$param" == *"="* ]]; then
                key="${param%%=*}"
                value="${param#*=}"
                
                if [ "$first" = true ]; then
                    first=false
                else
                    echo "," >> "$job_config"
                fi
                
                echo "    \"$key\": \"$value\"" >> "$job_config"
            fi
        done
        
        cat >> "$job_config" << EOF
  },
  "createdAt": "$(date -u +"%Y-%m-%dT%H:%M:%SZ")",
  "updatedAt": "$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
}
EOF
    fi
    
    # 渲染模板文件
    for template_file in "$template_dir"/*; do
        if [ -f "$template_file" ] && [ "$(basename "$template_file")" != "meta.json" ]; then
            filename=$(basename "$template_file")
            output_file="$output_dir/$filename"
            
            if [ "$dry_run" = true ]; then
                log_info "将生成文件: $filename"
                echo "--- $filename ---"
                render_template "$template_file" "/tmp/devops_preview_$$" "${params[@]}"
                cat "/tmp/devops_preview_$$"
                rm -f "/tmp/devops_preview_$$"
                echo
            else
                log_info "生成文件: $filename"
                render_template "$template_file" "$output_file" "${params[@]}"
            fi
        fi
    done
    
    if [ "$dry_run" = false ]; then
        log_success "作业配置创建完成: $output_dir"
        log_info "可以使用以下命令部署:"
        echo "  devops run $job_name --workspace $workspace"
    else
        log_info "预览完成 (使用 --dry-run 模式)"
    fi
}

# 验证作业配置
validate_job() {
    local workspace="$1"
    local job_name="$2"
    
    if [ -z "$workspace" ] || [ -z "$job_name" ]; then
        log_error "请指定工作空间和作业名称"
        return 1
    fi
    
    local job_dir="$WORKSPACE_DIR/$workspace/jobs/$job_name"
    local job_config="$job_dir/job.json"
    
    if [ ! -f "$job_config" ]; then
        log_error "作业配置不存在: $job_config"
        return 1
    fi
    
    log_info "验证作业配置: $workspace/$job_name"
    
    # 检查必需文件
    local required_files=("dockerfile" "deploy.yaml")
    local missing_files=()
    
    for file in "${required_files[@]}"; do
        if [ ! -f "$job_dir/$file" ]; then
            missing_files+=("$file")
        fi
    done
    
    if [ ${#missing_files[@]} -gt 0 ]; then
        log_error "缺少必需文件:"
        for file in "${missing_files[@]}"; do
            echo "  - $file"
        done
        return 1
    fi
    
    # 验证 JSON 格式
    if ! jq . "$job_config" > /dev/null 2>&1; then
        log_error "作业配置文件格式错误: $job_config"
        return 1
    fi
    
    log_success "作业配置验证通过"
    
    # 显示配置摘要
    echo
    log_info "配置摘要:"
    jq -r '
        "  作业名称: " + (.name // "未知") + "\n" +
        "  模板: " + (.template // "未知") + "\n" +
        "  工作空间: " + (.workspace // "未知") + "\n" +
        "  创建时间: " + (.createdAt // "未知")
    ' "$job_config"
}

# 主函数
main() {
    if [ $# -eq 0 ]; then
        show_help
        return 1
    fi
    
    local command="$1"
    shift
    
    case "$command" in
        list)
            list_templates
            ;;
        show)
            show_template "$@"
            ;;
        copy)
            copy_template "$@"
            ;;
        create)
            create_job "$@"
            ;;
        validate)
            validate_job "$@"
            ;;
        help|--help|-h)
            show_help
            ;;
        *)
            log_error "未知命令: $command"
            echo
            show_help
            return 1
            ;;
    esac
}

# 检查依赖
if ! command -v jq &> /dev/null; then
    log_error "需要安装 jq 工具"
    log_info "Ubuntu/Debian: sudo apt-get install jq"
    log_info "CentOS/RHEL: sudo yum install jq"
    log_info "macOS: brew install jq"
    exit 1
fi

# 执行主函数
main "$@"
