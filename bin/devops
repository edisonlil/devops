#!/bin/bash

# 获取脚本所在目录
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# 加载依赖脚本
source "$SCRIPT_DIR/log.sh"
source "$SCRIPT_DIR/tools.sh"
source "$SCRIPT_DIR/env.sh"
source "$SCRIPT_DIR/build.sh"
source "$SCRIPT_DIR/install_tools.sh"
source "$SCRIPT_DIR/workspace.sh"

# Docker检查移到具体命令处理中

if test ! -d $HOME/.devops ; then mkdir $HOME/.devops ; fi

#设置deploy文件生成位置
info "埋点: 当前的工作空间为:${env[opt_workspace]}"

#执行first命令
case ${env[cmd_1]} in
        run) run; ;;
        install-tools) install_tools; ;;
        template)
            # 调用模板管理工具
            shift # 移除 'template' 参数
            exec "$SCRIPT_DIR/devops_template" "$@"
            ;;
        env)
            shift
            subcmd="$1"; shift || true
            case "$subcmd" in
                use)
                    env_use "$1";
                    ;;
                harbor-login)
                    harbor_login_current;
                    ;;
                harbor-secret)
                    harbor_secret_manage;
                    ;;
                *)
                    echo "Usage: devops env <use|harbor-login|harbor-secret> ..."; exit 1 ;;
            esac
            ;;
        create)
            shift
            create_workspace "$@";
            ;;
        help|--help|-h) devops_help ;;
        *) devops_help ; exit 1 ; ;;
esac

