#!/bin/bash



function devops_help() {
	echo -e 'Usage:  devops [OPTIONS] COMMAND

	A cicd tool for devops

	Options:
	      --build-tool string    java build tool "maven" or "gradle"
	      --git-url string       the url of git registry
	      --git-branch string    the branch of git registry
	      --svn-url string       the url of svn registry
	      --java-opts string     the java -jar ${java-opts} foo.jar
	      --python-requirements string  python requirements file path (default: requirements.txt)
	      --python-main string   python main file path (default: app.py)
	      --dockerfile string    the use of the dockerfile for this job
	      --template string      the use of the docker swram or k8s template for this job
	      --build-cmds string    the cmd rewrite for building this job
	      --build-env string     build env "dev" "test" "gray" "prod" etc.
	      --build-version string build tool version "node:18.12,jdk:17,maven:3.9.3,python:3.11"
	      --namespace string     kubernetes namespace (default: "default")
	      --app-port int         container application port (default: 80)
	      --expose-port int      external expose port (NodePort, range: 30000-32767)
	      --service-port string  service ports config (multi-port support)
	      --export-port string   export ports config (multi-port NodePort support)
	      --force-port           force override template fixed port
	      --version              the version of devops
	      --workspace            the workspace
	      --platform             override BUILD_PLATFORM (KUBERNETES|DOCKER_SWARM|DOCKER_COMPOSE|SHELL)
              -i, --interactive      进入引导式交互配置模式

	Commands:
	  run <type> <name>            运行构建和部署（支持交互式 -i）
	  run middleware <template> <name>  部署中间件服务（支持交互式 -i）
	  middleware <action>          中间件管理（list/status/logs/remove/scale等）
	  install-tools                安装开发工具
	  env use <workspace>          切换默认工作空间
	  env harbor-login             登录当前工作空间的Harbor
	  env harbor-secret            管理K8s Harbor Secret
	  create workspace <name>      创建工作空间（支持交互式 -i）
	  copy workspace <src> <dst>   复制工作空间（支持交互式 -i）
	  template                     模板管理（list/show/create/validate）
	  shortcut <action>            快捷键管理（save/run/list/show/delete/edit）

	Examples:
	  # 交互式部署（推荐新手使用）
	  devops run java crm -i
	  devops run vue frontend -i
	  devops run python api -i
	  devops run -i  # 完全交互式，会提示选择类型和项目名

	  # 中间件部署（交互式）
	  devops run middleware redis-standalone cache-server -i
	  devops run middleware mysql-standalone main-db -i
	  devops run middleware redis-cluster cache-cluster -i

	  # 中间件部署（命令行）
	  devops run middleware redis-standalone cache-server --memory-limit 2Gi --storage-size 5Gi
	  devops run middleware mysql-standalone main-db --memory-limit 4Gi --storage-size 100Gi --mysql-database app_db
	  devops run middleware redis-cluster cache-cluster --replicas 6 --memory-limit 2Gi

	  # Shell 平台：执行模板启动脚本（默认 install.sh，可用 --start-script 指定）
	  # 需在 workspace/config 设置 BUILD_PLATFORM="SHELL"，模板目录下包含启动脚本
	  devops run middleware harbor-standalone harbor --start-script install.sh

	  # 传统命令行部署
	  devops run java crm --git-url https://git.example.com/crm.git
	  devops run vue frontend --git-url https://git.example.com/ui.git --build-env prod
	  devops run python api --git-url https://git.example.com/api.git --python-main server.py --service-port "5000"

	  # 创建工作空间（K8s，交互模式）
	  devops create workspace demo -i

	  # 创建工作空间（K8s，非交互）
	  devops create workspace demo \
	    --platform KUBERNETES \
	    --namespace dev \
	    --git-url https://git.example.com/org/repo.git \
	    --git-branch main \
	    --maven-settings /path/to/settings.xml \
	    --gradle-init-script /path/to/init.gradle \
	    --build-version "node:18.12,jdk:17,maven:3.9.3" \
	    --set-default

	  # 复制工作空间（交互模式）
	  devops copy workspace demo demo-test -i

	  # 复制工作空间（非交互，修改配置）
	  devops copy workspace demo demo-prod \
	    --namespace production \
	    --harbor-project prod-project \
	    --set-default

                  # 使用引导式交互模式运行构建
                  devops run java -i


	  # 运行构建（若未传 --git-url/--git-branch，使用工作空间默认配置）
	  devops run java my-app --template spring-boot

	  # 版本管理示例（使用--build-version参数）
	  devops run vue my-app --build-version "node:18.12" --build-env "prod"     # 指定Node.js版本和构建环境
	  devops run java my-app --build-version "jdk:17,maven:3.9.3"              # 指定JDK和Maven版本
	  devops run vue my-app --build-version "volta:18.12"                      # 使用Volta管理Node.js版本

	  # 中间件管理
	  devops middleware list                  # 列出已部署的中间件
	  devops middleware status cache-server   # 查看中间件状态
	  devops middleware logs cache-server --follow  # 查看中间件日志
	  devops middleware remove cache-server   # 删除中间件
	  devops middleware scale cache-cluster --replicas 8  # 扩缩容中间件
	  devops middleware backup main-db        # 备份中间件数据
	  devops middleware info cache-server     # 查看连接信息
	  devops middleware templates list        # 列出可用模板

	  # 模板管理
	  devops template list                    # 列出所有可用模板（全局和workspace）
	  devops template show spring-boot        # 显示模板详情
	  devops template copy spring-boot --workspace demo  # 复制全局模板到workspace
	  devops template create spring-boot demo # 基于模板创建作业

	  # 快捷键管理
	  devops shortcut save prod-deploy devops run java my-app --build-env prod --namespace production
	  devops shortcut list                    # 列出所有快捷键
	  devops prod-deploy                      # 执行快捷键
	  devops prod-deploy --override --git-branch hotfix  # 覆盖参数执行
	  devops shortcut show prod-deploy        # 查看快捷键详情
	  devops shortcut delete prod-deploy      # 删除快捷键
	  devops template validate demo demo-app  # 验证模板配置

	Version Management:
	  构建工具版本管理支持多级配置，优先级: 命令行 > workspace配置
	  --build-version 参数专门负责构建工具版本，格式: "工具:版本"
	  --build-env 参数专门负责构建环境配置，不再处理版本信息
	  支持的版本管理器:
	    - Node.js: nvm, fnm, n, volta
	    - Java: sdkman
	    - Maven: sdkman
	    - Gradle: sdkman
	    - Python: conda, pyenv
	  版本配置方式:
	    1. 命令行参数: --build-version "node:18.12,jdk:17"
	    2. Workspace配置: 在workspace/config中设置BUILD_VERSION
	  版本格式示例:
	    - --build-version "node:18.12"
	    - --build-version "jdk:17,maven:3.9.3"
	    - --build-version "volta:18.12"
	  与构建环境分离使用:
	    - devops run vue app --build-version "node:18.12" --build-env "prod"
	  Workspace默认版本:
	    - 在workspace配置文件中设置: BUILD_VERSION="node:18.12,jdk:17"
	    - 命令行参数会覆盖workspace配置

	Template Management:
	  支持全局模板和workspace级别模板：
	    - 全局模板: 存储在 templates/ 目录，所有workspace共享
	    - Workspace模板: 存储在 workspace/{name}/templates/ 目录
	    - 优先级: workspace模板 > 全局模板
	  模板操作:
	    - devops template copy <template-id> --workspace <name>  # 复制全局模板到workspace
	    - 复制后可自定义workspace模板，不影响全局模板
	    - 构建时自动优先使用workspace模板

	Interactive Deployment:
	  交互式部署提供引导式配置体验，智能显示workspace默认值：
	    - devops run <type> <name> -i  # 交互式部署指定项目
	    - devops run <type> -i         # 交互式部署，提示输入项目名
	    - devops run -i                # 完全交互式，提示选择类型和项目名
	  交互式特点:
	    - 智能提示: 显示workspace配置的默认值
	    - 可选填写: workspace有默认值的参数变为可选
	    - 引导配置: 逐步提示输入必要参数
	    - 命令预览: 显示等效的命令行形式
	  交互式流程:
	    1. 选择部署类型 (java/vue/go/nginx/tomcat/python)
	    2. 输入项目名称
	    3. 配置代码拉取 (Git/SVN)
	    4. 配置构建工具版本 (显示workspace默认值)
	    5. 配置部署参数 (模板、命名空间、端口等)
	    6. 确认并执行部署

	Multi-Port Configuration:
	  支持多端口配置，提供更灵活的端口管理：
	    - --service-port: 配置服务端口，支持多端口和命名端口
	    - --export-port: 配置导出端口（NodePort），支持多端口
	    - 与传统的--app-port和--expose-port参数兼容
	  端口配置格式:
	    --service-port "8080"                    # 单端口
	    --service-port "8080,9090,3000"         # 多端口
	    --service-port "http:8080,admin:9090"   # 命名端口
	    --service-port "8080,admin:9090,3000"   # 混合格式
	    --export-port "30080,30090"             # 多个NodePort
	    --export-port "http:30080,admin:30090"  # 命名NodePort
	  使用示例:
	    devops run java app --service-port "http:8080,admin:9090" --export-port "30080,30090"
	    devops run vue frontend --service-port "80,8080" --export-port "30080"

	Workspace Configuration:
	  每个workspace可以配置默认的构建工具版本：
	    - 配置文件: workspace/{name}/config
	    - 版本配置项: BUILD_VERSION="node:18.12,jdk:17,maven:3.9.3"
	    - 可选配置，不设置则不应用默认版本
	    - 命令行 --build-version 参数会覆盖workspace配置
	  配置示例:
	    BUILD_VERSION="node:18.12"           # 单个工具版本
	    BUILD_VERSION="jdk:17,maven:3.9.3"  # 多个工具版本
	    #BUILD_VERSION=""                    # 注释掉表示不使用默认版本

	Middleware Deployment:
	  中间件部署提供开箱即用的数据库、缓存、消息队列等基础设施服务：

	  支持的中间件类型:
	    缓存: redis-standalone, redis-cluster, redis-sentinel
	    数据库: mysql-standalone, mysql-ha, postgresql-standalone, postgresql-ha
	    消息队列: kafka-standalone, kafka-cluster, rabbitmq-standalone, rabbitmq-cluster
	    搜索引擎: elasticsearch-standalone, elasticsearch-cluster
	    存储: mongodb-standalone, mongodb-replicaset, minio-standalone, minio-distributed

	  中间件部署参数:
	    --memory-limit SIZE        内存限制 (如: 2Gi, 512Mi)
	    --storage-size SIZE        存储大小 (如: 10Gi, 100Gi)
	    --replicas COUNT          副本数量
	    --service-port PORT       服务端口
	    --export-port PORT        外部访问端口 (NodePort)
	    --backup-enabled          启用自动备份
	    --monitoring-enabled      启用监控

	  中间件特定参数:
	    Redis: --redis-password, --redis-persistence, --max-memory-policy
	    MySQL: --mysql-root-password, --mysql-database, --mysql-user, --mysql-charset
	    Kafka: --kafka-partitions, --kafka-retention-hours, --kafka-zookeeper-enabled

	  中间件管理命令:
	    list                      列出已部署的中间件
	    status <name>             查看中间件状态
	    logs <name>               查看中间件日志
	    remove <name>             删除中间件
	    scale <name> --replicas N 扩缩容中间件
	    backup <name>             备份中间件数据
	    restore <name> --from PATH 恢复中间件数据
	    info <name>               查看连接信息
	    templates list            列出可用模板

	Shell Platform:
	  当 BUILD_PLATFORM 为 SHELL 时，devops 不渲染/应用编排文件，而是执行模板目录下的启动脚本。
	  行为：
	    - 导出所有 middleware_* 变量为环境变量（下划线、大写），并设置 INSTANCE_NAME。
	    - 默认执行 install.sh；可通过命令行 --start-script 覆盖（等价 env[middleware_start_script]）。
	    - 模板搜索顺序：templates/shell/middleware/<name>；若不存在，回退到 templates/compose/middleware/<name>。
	  示例：
	    devops run middleware harbor-standalone harbor --start-script install.sh

	  使用示例:
	    devops run middleware redis-standalone cache --memory-limit 2Gi
	    devops run middleware mysql-standalone db --storage-size 100Gi --mysql-database app_db
	    devops middleware list
	    devops middleware status cache
	    devops middleware scale cache-cluster --replicas 6

	Install Tools:
	  devops install-tools 提供开发环境工具的自动安装和检查功能

	  选项:
	    --check                检查当前环境状态
	    --all                  安装所有支持的工具
	    --tools <tool1,tool2>  安装指定的工具（逗号分隔）
	    --java-version <ver>   指定Java版本 (8, 11, 17, 21)
	    --python-version <ver> 指定Python版本 (3.8, 3.9, 3.10, 3.11)
	    --help                 显示帮助信息

	  支持的工具:
	    基础工具: git, curl, wget, unzip
	    容器工具: docker, docker-compose
	    K8s工具:  kubectl, helm
	    Java工具: java, maven, gradle
	    Node工具: node, npm, yarn
	    Python工具: python, conda, pip
	    其他工具: go, expect

	  使用示例:
	    devops install-tools --check                    # 检查环境状态
	    devops install-tools --all                      # 安装所有工具
	    devops install-tools --tools python,conda,pip   # 安装Python环境
	    devops install-tools --tools java --java-version 17    # 安装Java 17
	    devops install-tools --tools python --python-version 3.11  # 安装Python 3.11'
	exit 1;

}


function devops_version() {
	echo -e 'devops version 1.7.1'
	echo ""
	echo "一键安装脚本可用:"
	echo "  ./install.sh        - 完整安装"
	echo "  ./quick-install.sh  - 快速安装"
	echo "  ./test-install.sh   - 测试安装"
	echo ""
	echo "使用 'make help' 查看更多管理命令"
	exit 1;
}

