#!/bin/bash

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/docker_helper.sh"

function nginx_build() {
	# 这里假定 scm() 已经将静态内容打包为 ${env[cfg_temp_dir]}/dist.tar
	cfg_temp_dir=${env[cfg_temp_dir]}
	cmd_job_name=${env[cmd_job_name]}
	tmp_dockerfile=${env[tmp_dockerfile]}
	cfg_harbor_address=${env[cfg_harbor_address]}
	cfg_harbor_project=${env[cfg_harbor_project]}
	tmp_docker_image_suffix=${env[tmp_docker_image_suffix]}

	# 构建目录即为打包后的临时目录
	if [ ! -f "$cfg_temp_dir/dist.tar" ]; then
		error "未找到静态资源包: $cfg_temp_dir/dist.tar"; exit 1
	fi

	# 检查是否为压缩的tar包，如果是则解压
	if [[ "$cfg_temp_dir/dist.tar" =~ \.(tar\.gz|tar\.bz2)$ ]]; then
		info "检测到压缩的tar包，正在解压..."
		if [[ "$cfg_temp_dir/dist.tar" =~ \.tar\.gz$ ]]; then
			gunzip -f "$cfg_temp_dir/dist.tar"
		elif [[ "$cfg_temp_dir/dist.tar" =~ \.tar\.bz2$ ]]; then
			bunzip2 -f "$cfg_temp_dir/dist.tar"
		fi
		info "tar包解压完成"
	fi

	env[tmp_build_dist_path]=$cfg_temp_dir

	# 复制模板文件到最终构建上下文
	copy_template_files_to_final_build_context

	# 构建镜像
	image_path=${cmd_job_name}_${tmp_docker_image_suffix}:latest
	if test ${env[cfg_enable_harbor]} -eq 1; then
	   image_path=$cfg_harbor_address/$cfg_harbor_project/$image_path
	fi

	docker build -t $image_path -f $tmp_dockerfile ${env[tmp_build_dist_path]}

	# 推送镜像
	docker_push $image_path
}


